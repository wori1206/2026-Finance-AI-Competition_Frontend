# 이 파일을 .env.local 로 복사해서 값을 채웁니다. 실제 값(키 · 주소)은 커밋하지 않습니다.

# 백엔드(FastAPI) 주소. 비우면 내 컴퓨터에서는 http://localhost:8080 (모의 백엔드)을 씁니다.
# 모의 백엔드는 백엔드 저장소에서 SUDDOE_MOCK=1 로 켭니다.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080

# Supabase 로그인. 비우면 Supabase 로그인을 쓰지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
